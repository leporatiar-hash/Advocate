# Frontend environment. Copy to .env.local for local dev.
#
# .env.local is gitignored and must stay that way — never put a real value in
# any file that is not .env.local.

# Where the FastAPI backend lives.
#   local dev:            http://localhost:8000
#   phone/Omnara preview: /backend   (see npm run dev:web:phone + dev:proxy)
#   production:           https://<your-railway-service>.up.railway.app
#
# This is NOT a secret — Next.js inlines NEXT_PUBLIC_* into the client bundle,
# so it is visible to anyone using the app. Set it in the Vercel dashboard for
# deployed environments rather than committing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
